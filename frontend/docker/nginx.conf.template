# Disajikan oleh image nginx resmi: ${BACKEND_URL} diisi dari variabel
# lingkungan saat kontainer dimulai.

# Pertahankan skema asli bila ada reverse proxy HTTPS di depan kontainer ini.
map $http_x_forwarded_proto $simlahan_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 100m;

    root /usr/share/nginx/html;
    index index.html;

    # Catatan: add_header di dalam location menimpa yang di level server,
    # sehingga header keamanan diulang pada location yang menambah header.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # API, panel admin SimLahan, portal pemohon, dan aplikasi lapangan / peta berbagi (/aset)
    location ~ ^/(v1|admin|auth|oauth|static|docs|redoc|swagger|portal|aset)(/|\.|$) {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $simlahan_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }

    location = /healthz { proxy_pass ${BACKEND_URL}; access_log off; }
    location = /readiness { proxy_pass ${BACKEND_URL}; access_log off; }

    # Aset hasil build (nama berhash) boleh di-cache lama.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # SPA: semua rute lain diarahkan ke index.html
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri /index.html;
    }
}
