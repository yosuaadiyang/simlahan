# URL API backend. Kosongkan untuk memakai "/v1" pada origin yang sama
# (mode produksi di belakang nginx / docker compose).
VITE_API_URL=http://localhost:8000/v1
VITE_STORAGE_PREFIX=SIMLAHAN
PORT=3000

# Identitas aplikasi
VITE_APP_NAME=SimLahan
VITE_ORGANIZATION_NAME=Sistem Informasi Manajemen Lahan

# Peta (WGS84). Pusat & zoom awal; default: seluruh Indonesia.
# Kabupaten/kota utama (dikelompokkan paling atas pada pencarian)
VITE_PRIMARY_MUNICIPALITY=
VITE_MAP_CENTER_LAT=1.08
VITE_MAP_CENTER_LNG=104.03
VITE_MAP_DEFAULT_ZOOM=11
# Opsional: layer WMS tambahan (mis. peta bidang/RDTR instansi Anda)
VITE_MAP_WMS_URL=
VITE_MAP_WMS_LAYERS=
VITE_MAP_WMS_NAME=Peta instansi

# Tampilkan latar "development" (bukan untuk produksi)
VITE_SHOW_DEV_BANNER=false

# Fitur opsional
## Pencarian kavling (plot search) untuk petugas
VITE_FLAG_PLOTSEARCH=false

# Opsional: pelaporan galat ke Sentry
VITE_SENTRY_DSN=

# Opsional: templat tautan eksternal ({id} diganti nilai)
VITE_DECISION_URL_TEMPLATE=
VITE_PLAN_REPORT_URL_TEMPLATE=
VITE_PLOT_DIVISION_URL_TEMPLATE=
