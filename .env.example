# ============================================================
# SimLahan – konfigurasi (salin menjadi .env, lalu isi)
# ============================================================

# --- Basis data -------------------------------------------------
POSTGRES_DB=simlahan
POSTGRES_USER=simlahan
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-kuat

# --- Keamanan (WAJIB diganti) ----------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ganti-dengan-string-acak-panjang
# Kunci enkripsi NIK/rekening/KK (UU PDP). Simpan baik-baik; jika hilang/berubah
# data terenkripsi tidak dapat dibaca.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DEBUG=0

# Nama host yang diizinkan & origin tepercaya (sesuaikan domain Anda)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set 0 bila diakses lewat HTTP biasa (tanpa HTTPS), mis. uji coba lokal.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
HTTP_PORT=8080

# --- Admin awal (dibuat sekali saat pertama kali dijalankan) -----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ganti-kata-sandi-admin
DJANGO_SUPERUSER_EMAIL=admin@example.go.id

# --- Identitas instansi -----------------------------------------
APP_NAME=SimLahan
ORGANIZATION_NAME=Instansi Pengelola Lahan
# URL publik aplikasi (https://domain-anda); dipakai tautan surel portal dan kode QR KPT/PPT
OFFICER_UI_URL=http://localhost:8080

# --- Surel (notifikasi tenggat, laporan) --------------------------
# Contoh SMTP: smtp+tls://user:password@smtp.example.go.id:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@example.go.id

# --- Token akses JWT ---------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_HOURS=12

# --- Peta (WGS84) ------------------------------------------------
# Bawaan: Pulau Rempang, Kec. Galang, Kota Batam.
# Seluruh Indonesia: -2.5 / 118 / zoom 5.
MAP_CENTER_LAT=0.87
MAP_CENTER_LNG=104.15
MAP_DEFAULT_ZOOM=12
PRIMARY_MUNICIPALITY=Kota Batam
# Layer WMS opsional (mis. peta bidang/RDTR milik instansi)
MAP_WMS_URL=
MAP_WMS_LAYERS=
MAP_WMS_NAME=Peta instansi

# --- Fitur opsional ----------------------------------------------
FLAG_PLOTSEARCH=false
SENTRY_DSN=
