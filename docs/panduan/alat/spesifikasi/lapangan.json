      {
       "wait": 2500
      },
      {
       "js": "let e=document.querySelector('#jenis'); while(e && !(e.scrollHeight>e.clientHeight+5 && getComputedStyle(e).overflowY!=='visible')) e=e.parentElement; const f=document.querySelector('label[for=foto]')||document.querySelector('#foto'); if(e) e.scrollTop += f.getBoundingClientRect().top - e.getBoundingClientRect().top - 14; else f.scrollIntoView()"
      },
      {
       "wait": 600
      }
     ],
     "mark": [
      [
       "#foto",
       "1"
      ],
      [
       "label:has(#titik-manual)",
       "2"
      ],
