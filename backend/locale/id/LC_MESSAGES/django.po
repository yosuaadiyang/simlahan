msgid "parameter format string"
msgstr "format string parameter"

#, python-brace-format
msgid ""
"String that defines how the parameters are formatted when calling the "
"command. E.g. if this is \"--rent-id {rent_id}\" and value 123 is passed as "
"an argument to the rent_id parameter, then the command will be called as "
"\"COMMAND --rent-id 123\"."
msgstr ""
"String yang menentukan format parameter saat perintah dipanggil. Mis. jika "
"nilainya \"--rent-id {rent_id}\" dan nilai 123 diberikan sebagai argumen "
"parameter rent_id, perintah dipanggil sebagai \"COMMAND --rent-id 123\"."

